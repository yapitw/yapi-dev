{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "redirects": [
    { "source": "/exp/Lab15", "destination": "/lab/vortex", "permanent": true },
    { "source": "/exp/Lab14", "destination": "/lab/waves", "permanent": true },
    { "source": "/exp/Lab13", "destination": "/lab/galaxy", "permanent": true },
    { "source": "/exp/Lab12", "destination": "/lab/noise-flow-2", "permanent": true },
    { "source": "/exp/Lab11", "destination": "/lab/hex-runner", "permanent": true },
    { "source": "/exp/Lab10", "destination": "/lab/little-creature", "permanent": true },
    { "source": "/exp/Lab7", "destination": "/lab/noise-pace", "permanent": true },
    { "source": "/exp/Lab6", "destination": "/lab/noise-flow", "permanent": true },
    { "source": "/exp/Lab5", "destination": "/lab/noise-direction", "permanent": true },
    { "source": "/exp/Lab4", "destination": "/lab/reaction-diffusion-draw", "permanent": true },
    { "source": "/exp/Lab3", "destination": "/lab/reaction-diffusion", "permanent": true },
    { "source": "/exp/:path*", "destination": "/lab", "permanent": true },
    { "source": "/web", "destination": "/work", "permanent": true },
    {
      "source": "/about",
      "has": [{ "type": "query", "key": "lang", "value": "zh" }],
      "destination": "/about/zh",
      "permanent": true
    }
  ]
}
